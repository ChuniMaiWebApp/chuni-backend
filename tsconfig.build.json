{
  "extends": "./tsconfig.json",
  // rootDir is pinned so that adding files outside src/ (scripts/, test/)
  // cannot shift the common root and emit dist/src/main.js instead of
  // dist/main.js.
  "compilerOptions": {
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
