# =============================================================================
# ChunithmWebApp API — PRODUCTION environment template
#
# On the VPS:  cp backend/.env.production.example backend/.env  &&  nano it
#
# Differs from .env.example in more than the passwords, so do not start from
# that one: Swagger is off, the proxy hop is declared, CORS names the real
# domain, and Supabase is left blank because production runs plain Postgres.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=production
PORT=3333
API_PREFIX=api

# Every interface *inside the container*. Loopback here would mean the
# container's own loopback, unreachable from nginx on the host. Exposure is
# limited by docker-compose.yml, which publishes only to 127.0.0.1.
HOST=0.0.0.0

# The app and the API are separate hosts, so every browser call to the API is a
# real cross-origin request and this list is load-bearing, not a backstop. `*`
# is not an option: browsers reject a wildcard origin together with
# `credentials: true`, and the session cookie needs credentials.
CORS_ORIGIN=https://chunithm-app.novaseele.com

# Scope the session cookie to the parent domain so both hosts can see it.
#
# Without this the cookie belongs to chunithm-api alone. XHR to the API would
# still carry it — same site — but the document request to chunithm-app would
# not, so Nuxt would render every page signed out and the header would flip on
# hydration. The leading dot also covers the maimai hosts when they arrive.
COOKIE_DOMAIN=.novaseele.com

# Off in production. The docs page publishes every route, its DTOs, and the
# shape of the sign-in body — a free map of the attack surface.
SWAGGER_ENABLED=false

# One proxy hop: nginx, on this same host. Required, or the sign-in rate limiter
# sees 127.0.0.1 for every visitor and throttles the whole site as one client.
# See nginx/chunithm.conf — it overwrites X-Forwarded-For rather than appending,
# so a client cannot forge an address by sending its own header.
TRUST_PROXY=1

# --- Database ----------------------------------------------------------------
# Host is `postgres`, the container's alias on the shared `chunimai` network —
# not 127.0.0.1, which inside a container is the container itself. The password
# must match ../chunimai-database/.env.prod → POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/postgres

# Generate with: openssl rand -base64 32
# Encrypts the CHUNITHM-NET cookie jars at rest. Losing it means every player
# has to link their account again; leaking it means someone else can act as
# them on CHUNITHM-NET, up to renaming the account.
ENCRYPTION_KEY=

# Generate with: openssl rand -base64 32
# Signs the session cookie. Changing it signs everybody out.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Supabase ----------------------------------------------------------------
# Intentionally blank, even though Studio runs at my-db.novaseele.com.
#
# Studio talks to postgres-meta, not to the API, and the API talks to Postgres
# directly through `pg`. Nothing outside the health check ever called Supabase,
# and production has no Kong for it to call. Left blank, /health simply stops
# reporting on it instead of showing "down" forever — which matters, because
# the deploy script rolls back on anything other than "ok".
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis -------------------------------------------------------------------
# Same reasoning as DATABASE_URL: a container alias, not loopback.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Song data ---------------------------------------------------------------
# Chart constants, from chunirec's developer API: https://developer.chunirec.net/
#
# Not optional in practice. The catalogue still loads without it — titles,
# artists, levels and jackets all come from SEGA — but every chart arrives with
# no constant, and play rating, Best 50 and OVER POWER are all computed from
# the constant. A deployment missing this serves zeroes, not degraded data.
CHUNIREC_TOKEN=

# Keep this on for exactly one process. Two processes with it on would both
# wake at 08:00 UTC — the Redis lock handles that, but there is no reason to
# make it work for a living.
SONG_DATA_AUTO_REFRESH=true
