# =============================================================================
# ChunithmWebApp API - environment template
# Copy to .env and fill in the values:  cp .env.example .env
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development

# 3000 = Supabase Studio, 3001 = PostgREST, 3100 = Nuxt frontend
PORT=3333

# All routes are served under /<API_PREFIX>/v1
API_PREFIX=api

# Comma separated list of allowed origins, or * to allow everything
CORS_ORIGIN=http://localhost:3100

# Serve OpenAPI docs at /<API_PREFIX>/docs
SWAGGER_ENABLED=true

# --- Database ----------------------------------------------------------------
# Port 5433, not 5432: this machine runs a native PostgreSQL (ServBay) bound to
# 127.0.0.1:5432, which shadows Docker's wildcard bind. See
# ../supabase-local/docker-compose.override.yml.
# Password comes from supabase-local/.env -> POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/postgres

# 32-byte key (base64). Encrypts CHUNITHM-NET cookie jars at rest — these can
# rename a player's account, so never commit a real one.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Signs session tokens issued to the frontend.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Supabase (see ../supabase-local) ----------------------------------------
# Kong gateway URL. Studio: http://localhost:3000
SUPABASE_URL=http://localhost:8095

# Copy from supabase-local/.env
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (see ../redis, runs inside WSL) -----------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Song data ---------------------------------------------------------------
# The API refreshes the song catalogue and the Inter/Japan region flags daily
# at 08:00 UTC, and catches up at boot if the last run was over 36h ago.
# Set to false for a process that must make no outbound calls, or when another
# deployment already owns the job.
SONG_DATA_AUTO_REFRESH=true
